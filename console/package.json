{
  "name": "yyjio",
  "productName": "YYJio",
  "version": "1.1.4",
  "description": "痒痒鸡 · 阴阳师自动化控制台（多实例管理与任务编排，引擎解耦版）",
  "main": "main.js",
  "author": "YYJio",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/patch-nsis-template.mjs",
    "dist": "node scripts/patch-nsis-template.mjs && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "bot.yyjio.app",
    "productName": "YYJio",
    "copyright": "YYJio · GPL-3.0 · based on runhey/OAS",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../engine",
        "to": "engine",
        "filter": [
          "**/*",
          "!log/**",
          "!.cache/**",
          "!tests/**",
          "!__pycache__/**",
          "!config/*.json",
          "!config/*.bak",
          "!config/*.tmp",
          "!config/gui_avatars/**",
          "!config/deploy.yaml"
        ]
      },
      {
        "from": "../engine/config/template.json",
        "to": "engine/config/template.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "YYJio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YYJio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
